{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StreamingAppS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::streamingapp-vignesh-457660516966/*"
    },
    {
      "Sid": "StreamingAppBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::streamingapp-vignesh-457660516966"
    }
  ]
}
